{
  "name": "@optimai-network/x402-sdk",
  "version": "0.3.1",
  "description": "Typed client SDK for OptimAI x402-paid search endpoints.",
  "author": "OptimAI Network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimaiNetwork/optimai-x402-sdk.git"
  },
  "homepage": "https://github.com/OptimaiNetwork/optimai-x402-sdk#readme",
  "bugs": {
    "url": "https://github.com/OptimaiNetwork/optimai-x402-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:local": "pnpm run smoke:local:evm",
    "smoke:local:evm": "pnpm run build && node scripts/smoke-local-evm.mjs",
    "smoke:local:solana": "pnpm run build && node scripts/smoke-local-solana.mjs",
    "compat:local": "pnpm run compat:local:evm",
    "compat:local:evm": "pnpm run build && node scripts/compat-local-evm.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "optimai",
    "x402",
    "sdk",
    "search",
    "agent",
    "payments"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "dependencies": {
    "@scure/base": "^1.2.6",
    "@solana/kit": "^5.5.1",
    "@solana/sysvars": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@x402/evm": "^2.6.0",
    "@x402/fetch": "^2.6.0",
    "@x402/svm": "^2.7.0",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.12",
    "typescript": "^5.6.3"
  }
}
