{
  "name": "@optimai-network/x402-sdk",
  "version": "0.2.1",
  "description": "Typed client SDK for OptimAI x402-paid search endpoints.",
  "author": "OptimAI Network",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:local": "pnpm run build && node scripts/smoke-local.mjs",
    "compat:local": "pnpm run build && node scripts/compat-local.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "optimai",
    "x402",
    "sdk",
    "search",
    "agent",
    "payments"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "dependencies": {
    "@x402/evm": "^2.6.0",
    "@x402/fetch": "^2.6.0",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.12",
    "typescript": "^5.6.3"
  }
}
